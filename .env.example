# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Optional Supabase project URL for production PostgreSQL + Auth persistence.
# When omitted, TIME TAX runs in clearly labeled Demonstration Mode backed by the local server store.
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Optional public anon key for Supabase Auth.
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Optional server-only Supabase key for privileged admin operations.
# Never exposed to client code.
SUPABASE_SERVICE_ROLE_KEY=""
